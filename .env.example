# LLM
ANTHROPIC_API_KEY=

# Slack (trigger ingestion + status report-back)
# Bot token from your Slack app (OAuth & Permissions > Bot User OAuth Token).
# Needs scopes: channels:history, channels:read, chat:write
SLACK_BOT_TOKEN=
SLACK_REPORT_CHANNEL=

# Google (Gmail context retrieval + Drive doc retrieval/output)
# From a Google Cloud OAuth client of type "Desktop app":
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Written by `python -m scripts.google_oauth_setup`; loaded + refreshed
# automatically after that.
GOOGLE_TOKEN_PATH=token.json

DRIVE_OUTPUT_FOLDER_ID=
